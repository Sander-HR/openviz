# Docker-first local development defaults
POSTGRES_USER=openviz
POSTGRES_PASSWORD=openviz
POSTGRES_DB=openviz
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6379
APP_HOST_PORT=3000

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_random_32_plus_char_secret

DEV_ADMIN_ID=00000000-0000-0000-0000-000000000000
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_NAME=Demo Admin
DEMO_PASSWORD=openviz-demo-password
NEXT_PUBLIC_DEMO_PASSWORD=openviz-demo-password
NEXT_PUBLIC_DEV_ADMIN_EMAIL=admin@example.com

VITE_USE_MOCK_RENDER=true
NEXT_PUBLIC_USE_MOCK_RENDER=true
