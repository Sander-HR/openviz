VITE_USE_MOCK_RENDER=true
NEXT_PUBLIC_USE_MOCK_RENDER=true

# Database
DATABASE_URL=postgres://localhost:5432/openviz

# Auth.js (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme_at_least_32_characters_long

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
 # Email (Magic Links)
EMAIL_SERVER=smtp://smtp.gmail.com:587
EMAIL_FROM=noreply@domain.nl

# S3 Storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Redis
REDIS_URL=redis://localhost:6379

# Dev Admin Credentials
DEV_ADMIN_ID=00000000-0000-0000-0000-000000000000
DEV_ADMIN_EMAIL=demo@demo.com
DEV_ADMIN_NAME="Demo Admin"
DEMO_PASSWORD=demo_password_123
NEXT_PUBLIC_DEMO_PASSWORD=demo_password_123
NEXT_PUBLIC_DEV_ADMIN_EMAIL=demo@demo.com