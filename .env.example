VITE_USE_MOCK_RENDER=true
NEXT_PUBLIC_USE_MOCK_RENDER=true

# Database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openviz
DATABASE_URL=postgres://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Auth.js (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_key_at_least_32_characters_long

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
 # Email (Magic Links)
EMAIL_SERVER=smtp://smtp.gmail.com:587
EMAIL_FROM=noreply@yourdomain.com

# S3 Storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Redis
REDIS_URL=redis://localhost:6379

# Dev Admin Credentials
DEV_ADMIN_ID=00000000-0000-0000-0000-000000000000
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_NAME="Demo Admin"
DEMO_PASSWORD=your_demo_password
NEXT_PUBLIC_DEMO_PASSWORD=your_demo_password
NEXT_PUBLIC_DEV_ADMIN_EMAIL=admin@example.com

# Email Domain Filter (for OAuth sign-in)
# Supports comma-separated values: ALLOWED_EMAIL_DOMAIN=@hr.nl,@company.com,@example.org
ALLOWED_EMAIL_DOMAIN=@yourdomain.com
