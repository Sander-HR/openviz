# Local mock mode defaults (recommended for first run)
VITE_USE_MOCK_RENDER=true
NEXT_PUBLIC_USE_MOCK_RENDER=true

# ComfyUI (optional; ComfyUI's default local port is 8188)
COMFYUI_URL=http://localhost:8188

# Database (required)
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/openviz

# Collaboration server (secret must match the collab server's COLLAB_TOKEN_SECRET)
COLLAB_TOKEN_SECRET=replace_with_the_same_secret_as_the_collab_server
# Optional: pin the collaboration WebSocket endpoint. When unset, it is derived
# from the domain the page was opened from — ws(s)://<host>:1234, with no
# explicit port for *.devtunnels.ms (the tunnel subdomain encodes the port).
# NEXT_PUBLIC_COLLAB_URL=wss://collab.example.com
# Optional: per-host endpoints (comma-separated host=url pairs). The browser
# picks the entry matching the domain it opened the app from; takes precedence
# over NEXT_PUBLIC_COLLAB_URL. Example:
# NEXT_PUBLIC_COLLAB_URLS=localhost=ws://localhost:1234,my-tunnel-1234.euw.devtunnels.ms=wss://my-tunnel-1234.euw.devtunnels.ms

# Auth.js (required)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_random_32_plus_char_secret
# Optional explicit 32-byte base64 key for encrypting account-scoped AI secrets.
# If omitted, NEXTAUTH_SECRET is used as the key derivation input.
AI_SETTINGS_ENCRYPTION_KEY=

# Dev Admin Credentials (required for local credential login)
DEV_ADMIN_ID=00000000-0000-0000-0000-000000000000
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_NAME=Demo Admin
DEMO_PASSWORD=replace_with_a_strong_local_password
NEXT_PUBLIC_DEMO_PASSWORD=replace_with_a_strong_local_password
NEXT_PUBLIC_DEV_ADMIN_EMAIL=admin@example.com

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Email Magic Links (optional)
EMAIL_SERVER=smtp://smtp.gmail.com:587
EMAIL_FROM=noreply@yourdomain.com

# S3 Storage — object storage for images/assets so node state holds small URL
# refs instead of inline base64. `pnpm run dev` starts a local SeaweedFS
# container and creates the bucket automatically (see scripts/setup-s3.ts).
# Point these at your own S3/R2 backend, or leave empty to fall back to base64
# mock mode. SeaweedFS accepts any credentials but needs a concrete region.
S3_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=openviz-assets
S3_REGION=us-east-1

# Redis (optional in local mock mode)
REDIS_URL=redis://localhost:6379

# Email Domain Filter (optional)
# Supports comma-separated values: @hr.nl,@company.com,@example.org
ALLOWED_EMAIL_DOMAIN=@yourdomain.com
