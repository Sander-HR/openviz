{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openviz/extraction-output.schema.json",
  "title": "ExtractionOutput",
  "description": "FR-018 structured extraction result (NOT generated pixels). Produced by the vision stage; color hex values are refined by deterministic pixel sampling (research R2). Background content must be excluded.",
  "type": "object",
  "required": ["kind", "sampleBy", "components", "confidence"],
  "properties": {
    "kind": { "enum": ["color", "material", "parts"] },
    "sampleBy": { "enum": ["hierarchy", "region"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "region"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "description": "Semantic role (parts kind)" },
          "region": {
            "type": "object",
            "description": "Normalized bounding box, 0-1 coordinates relative to source image",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
            }
          },
          "color": {
            "type": ["object", "null"],
            "description": "color kind only: representative color + deterministic hex + per-component confidence",
            "required": ["hex", "confidence"],
            "properties": {
              "label": { "type": "string" },
              "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "material": {
            "type": ["object", "null"],
            "description": "material kind only: observations separated from inferences (FR-018)",
            "required": ["observations", "inferences"],
            "properties": {
              "category": { "type": "string" },
              "finish": { "type": "string" },
              "texture": { "type": "string" },
              "roughnessImpression": { "type": "string" },
              "metallicAppearance": { "type": "boolean" },
              "reflectivity": { "type": "string" },
              "observations": { "type": "array", "items": { "type": "string" } },
              "inferences": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
